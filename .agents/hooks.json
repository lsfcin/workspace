{
  "workspace-policy": {
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "cd ~/workspace && sh core/run hooks/antigravity/antigravity_policy.py PreToolUse",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "cd ~/workspace && sh core/run hooks/antigravity/antigravity_policy.py PostToolUse",
            "timeout": 30
          }
        ]
      }
    ],
    "PreInvocation": [
      {
        "type": "command",
        "command": "cd ~/workspace && sh core/run hooks/antigravity/antigravity_policy.py PreInvocation",
        "timeout": 30
      }
    ]
  }
}
