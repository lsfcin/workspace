# Python bytecode
**/__pycache__/
**/*.pyc

# Vendor / dependency directories — never tracked, workspace-wide.
**/node_modules/

# Scratch / experiments (ablation benches, throwaway sandboxes, etc.)
tmp/

# Trash
.Trash-1000/

# OS / Windows artifacts
$RECYCLE.BIN/
System Volume Information/
.fuse_hidden*

# Downloads
Downloads/

# Local working outputs: audit reports, review notes, roadmaps, plan files.
# These are session-local artefacts and must not be versioned here;
# paper-level outputs live inside each project's own repo.
outputs/
**/iq-fix-roadmap.md
ROADMAP.md
# Exception: the root workspace-os ROADMAP is the durable v1-strong plan (NOT session-local) —
# it holds decided policy that must sync across machines, tracked like core/ROADMAP.md. The
# leading slash anchors to repo root so nested project ROADMAPs (academy/papers/…) stay local.
!/ROADMAP.md

# Domain folders: track only workspace-structure files by name.
# Project-internal files (STATUS.md, BENCHMARKS.md, etc.) are not workspace
# concerns — they belong to each project's own git repo.

code/*
!code/CONTEXT.md
!code/SETUP.md
# A type and its shards, as a glob rather than one line each: an allowlist that enumerates
# files stops covering a document the moment it outgrows the line cap and splits, and the
# shard lands untracked with nothing saying so. Same shape as the citation gate's exemption
# and generated.txt — a shard inherits what its index has.
!code/SPECS.md
!code/SPECS-*.md
!code/ROADMAP-*.md
!code/eslint.shared.js
!code/laplata/
code/laplata/*
!code/laplata/CONTEXT.md
!code/gira/
code/gira/*
!code/gira/CONTEXT.md
!code/cria/
code/cria/*
!code/cria/CONTEXT.md
!code/_templates/
code/_templates/*
!code/_templates/*.md

academy/*
!academy/CONTEXT.md
!academy/SETUP.md
!academy/classes/
academy/classes/*
!academy/classes/CONTEXT.md
!academy/lab/
academy/lab/*
!academy/lab/CONTEXT.md
!academy/papers/
academy/papers/*
# Domain-level .md files here are structural workspace types (CONTEXT, ROADMAP, SPECS,
# …) and belong to the workspace repo; the per-paper SUBDIRECTORIES stay ignored and
# keep their own repos. Excepting the whole top-level *.md glob rather than one name at
# a time (2026-07-30): ROADMAP.md had been ignored and untracked in every repo, so it
# had no history anywhere, which breaks the assumption that "done work is deleted, git
# is the history" rests on. Naming each type individually is how that gap appeared.
!academy/papers/*.md
!academy/papers/pls-pix/
academy/papers/pls-pix/*
!academy/papers/pls-pix/CONTEXT.md
!academy/papers/mutual-credit-ai/
academy/papers/mutual-credit-ai/*
!academy/papers/mutual-credit-ai/CONTEXT.md
!academy/papers/mechanism-search/
academy/papers/mechanism-search/*
!academy/papers/mechanism-search/CONTEXT.md
!academy/papers/2027-CHI-cria/
academy/papers/2027-CHI-cria/*
!academy/papers/2027-CHI-cria/CONTEXT.md
!academy/papers/ai4good/
academy/papers/ai4good/*
!academy/papers/ai4good/CONTEXT.md
!academy/papers/wos-ablation/
academy/papers/wos-ablation/*
!academy/papers/wos-ablation/CONTEXT.md

branches/*
!branches/CONTEXT.md
!branches/instituto/
branches/instituto/*
!branches/instituto/CONTEXT.md
!branches/casinhas/
branches/casinhas/*
!branches/casinhas/CONTEXT.md
!branches/financas/
branches/financas/*
!branches/financas/CONTEXT.md
!branches/saude/
branches/saude/*
!branches/saude/CONTEXT.md
!branches/writing/
branches/writing/*
!branches/writing/mantras.md
!branches/writing/drafts/
branches/writing/drafts/*
!branches/writing/drafts/CONTEXT.md

core/*
!core/CONTEXT.md
!core/ROADMAP.md
# The law and the conventions, INCLUDING their shards. Named one by one until 2026-08-20, which
# left every SCHEMA-*.md and SPECS-*.md silently untracked — a clone got an index pointing at four
# files it did not have. A type that shards must be allowlisted by its shape, never by enumeration.
!core/SCHEMA.md
!core/SCHEMA-*.md
!core/SPECS.md
!core/SPECS-*.md
!core/features.txt
!core/profile.txt
!core/agents/
!core/experiments/
!core/flows/
!core/hooks/
!core/norms/
!core/prompts/
!core/refs/
!core/skills/
!core/tools/

models/*
!models/CONTEXT.md

datasets/*
!datasets/CONTEXT.md
!datasets/relativistic_raytracer/
datasets/relativistic_raytracer/*
!datasets/relativistic_raytracer/CONTEXT.md

brain/*
!brain/CONTEXT.md
!brain/FOUNDATIONS.md
!brain/SPECS.md
!brain/GOALS.md
!brain/ARCHIVE.md
!brain/USER.md
!brain/INBOX.md
!brain/.log/
!brain/attachments/
brain/attachments/*
!brain/attachments/CONTEXT.md
!brain/attachments/instituto-estrategias.md
!brain/goals/
brain/goals/*
!brain/goals/*.md
!brain/memory/
brain/memory/*
!brain/memory/*.md

# Nested project repos — each has its own git repo (AGENTS.md: internal projects use
# their own repos). They must NOT be embedded as gitlinks in the workspace: a fresh
# clone can't fetch them, and every internal commit flags a spurious "M". Git can't
# track individual files (e.g. CONTEXT.md) inside a nested repo anyway — routing reads
# them off-disk. So ignore each repo dir wholesale. Enforced by core/hooks/git/gitlink_gate.py.
academy/papers/2027-CHI-cria
academy/papers/ai4good
academy/papers/mechanism-search
academy/papers/mutual-credit-ai
academy/papers/pls-pix
academy/papers/wos-ablation
branches/casinhas
branches/instituto
code/aiwbot
code/apptime
code/corpora
code/cria
code/dobra
code/flows
code/futebots
code/gira
code/isometric-perspective
code/isoroll-content
code/isoroll-module
code/laplata
code/ppc
code/shortvid
code/spacemantics
code/voti
code/statem

# Plain content dirs (no nested repo) — fully trackable.
!code/prog1/
!code/programacao1/
!academy/administration/
!academy/refs/
!academy/talks/
!academy/teaching/
!branches/ecovila/
!core/prompts/
!academy/reviews/
!core/experiments/
!core/norms/

# ZCode session artifacts — config.json and CONTEXT.md are tracked; the skills/ mirror is not.
.zcode/plans/

# The skill mirrors. One source, core/skills/<name>.md; four published copies, because every harness
# looks in its own directory. Generated, never authored — regenerated by SETUP.md § Skill mirrors on
# install, by core/hooks/postedit/sync.sh on edit and create, and by the pre-commit generator, which
# also prunes a deleted skill's leftovers. They were symlinks until 2026-08-29, when Git Bash was
# found to copy silently unless Developer Mode is on; copying removes the per-OS axis instead of
# adding an arm for it. Tracking them churned 60 files on every skill edit, which is the maintenance
# the ruling exists to delete — "auto-generated content is totally fine given it is not versioned"
# (Lucas, 2026-08-29).
# The PUBLISHED units, not the trees: `<name>/SKILL.md` is a mirror, `<name>.md` is a command.
# Ignoring the tree itself would take each directory's own CONTEXT.md with it, and git cannot
# re-include a file whose parent directory is excluded — so the routing chain would break with no
# generator able to put it back.
.claude/skills/*/
.claude/commands/*.md
.opencode/skills/*/
.zcode/skills/*/
!branches/google-migration/
!branches/shoplist/
!branches/tips/
!branches/tweaks/

# The workspace venv. Local to one machine, never versioned.
.venv/
