{
  "hooks": {
    "enabled": true,
    "events": {
      "PreToolUse": [
        {
          "matcher": "Read|Edit|Write|ApplyPatch|Grep|NotebookEdit",
          "hooks": [
            {
              "type": "command",
              "timeout": 30,
              "command": "sh ${ZCODE_PROJECT_DIR}/core/run hooks/read/context-gate.py"
            }
          ]
        },
        {
          "matcher": "Bash",
          "hooks": [
            {
              "type": "command",
              "timeout": 30,
              "command": "sh ${ZCODE_PROJECT_DIR}/core/run hooks/read/bash-context-gate.py"
            },
            {
              "type": "command",
              "timeout": 30,
              "command": "sh ${ZCODE_PROJECT_DIR}/core/run hooks/checks/heredoc-gate.py"
            }
          ]
        },
        {
          "matcher": "Edit|Write|ApplyPatch",
          "hooks": [
            {
              "type": "command",
              "timeout": 60,
              "command": "sh ${ZCODE_PROJECT_DIR}/core/run hooks/checks/pre-edit.py"
            },
            {
              "type": "command",
              "timeout": 60,
              "command": "sh ${ZCODE_PROJECT_DIR}/core/run hooks/facade/facade-scan.py"
            },
            {
              "type": "command",
              "timeout": 60,
              "command": "sh ${ZCODE_PROJECT_DIR}/core/run hooks/facade/facade-gate.py"
            },
            {
              "type": "command",
              "timeout": 30,
              "command": "sh ${ZCODE_PROJECT_DIR}/core/run hooks/checks/issues-gate.py"
            },
            {
              "type": "command",
              "timeout": 30,
              "command": "sh ${ZCODE_PROJECT_DIR}/core/run hooks/read/spec-read-gate.py"
            }
          ]
        },
        {
          "matcher": "Read",
          "hooks": [
            {
              "type": "command",
              "timeout": 30,
              "command": "sh ${ZCODE_PROJECT_DIR}/core/run hooks/read/pre-read.py"
            }
          ]
        },
        {
          "matcher": "Agent|Task",
          "hooks": [
            {
              "type": "command",
              "timeout": 30,
              "command": "sh ${ZCODE_PROJECT_DIR}/core/run hooks/read/agent-context.py"
            }
          ]
        },
        {
          "matcher": "WebFetch",
          "hooks": [
            {
              "type": "command",
              "timeout": 10,
              "command": "sh ${ZCODE_PROJECT_DIR}/core/hooks/zcode/probe-deny.sh"
            }
          ]
        }
      ],
      "PostToolUse": [
        {
          "matcher": "Edit|Write|ApplyPatch",
          "hooks": [
            {
              "type": "command",
              "timeout": 120,
              "command": "bash ${ZCODE_PROJECT_DIR}/core/hooks/post-edit.sh"
            }
          ]
        },
        {
          "matcher": "Read",
          "hooks": [
            {
              "type": "command",
              "timeout": 30,
              "command": "sh ${ZCODE_PROJECT_DIR}/core/run hooks/facade/facade-tracker.py"
            },
            {
              "type": "command",
              "timeout": 30,
              "command": "sh ${ZCODE_PROJECT_DIR}/core/run hooks/read/context-tracker.py"
            }
          ]
        }
      ],
      "UserPromptSubmit": [
        {
          "hooks": [
            {
              "type": "command",
              "timeout": 30,
              "command": "sh ${ZCODE_PROJECT_DIR}/core/run hooks/session/context-meter.py"
            }
          ]
        }
      ],
      "SessionStart": [
        {
          "matcher": "^compact$",
          "hooks": [
            {
              "type": "command",
              "timeout": 30,
              "command": "sh ${ZCODE_PROJECT_DIR}/core/run hooks/session/precompact-wipe.py"
            }
          ]
        },
        {
          "hooks": [
            {
              "type": "command",
              "timeout": 30,
              "command": "sh ${ZCODE_PROJECT_DIR}/core/run hooks/session/session-prune.py"
            },
            {
              "type": "command",
              "timeout": 30,
              "command": "sh ${ZCODE_PROJECT_DIR}/core/run hooks/git/branch_marker.py record"
            },
            {
              "type": "command",
              "timeout": 30,
              "command": "sh ${ZCODE_PROJECT_DIR}/core/run hooks/session/mirror-heal.py"
            },
            {
              "type": "command",
              "timeout": 30,
              "command": "sh ${ZCODE_PROJECT_DIR}/core/run hooks/session/inbox-nudge.py"
            },
            {
              "type": "command",
              "timeout": 30,
              "command": "sh ${ZCODE_PROJECT_DIR}/core/run hooks/session/compass-nudge.py"
            },
            {
              "type": "command",
              "timeout": 10,
              "command": "sh ${ZCODE_PROJECT_DIR}/core/hooks/zcode/probe.sh SessionStart"
            }
          ]
        }
      ]
    }
  }
}
