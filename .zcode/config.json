{
  "hooks": {
    "enabled": true,
    "events": {
      "PreToolUse": [
        {
          "matcher": "Read|Edit|Write|ApplyPatch|Grep|NotebookEdit",
          "hooks": [
            {
              "type": "command",
              "timeout": 30,
              "command": "sh ${CLAUDE_PROJECT_DIR}/core/hooks/run read/context-gate.py"
            }
          ]
        },
        {
          "matcher": "Bash",
          "hooks": [
            {
              "type": "command",
              "timeout": 30,
              "command": "sh ${CLAUDE_PROJECT_DIR}/core/hooks/run read/bash-context-gate.py"
            },
            {
              "type": "command",
              "timeout": 30,
              "command": "sh ${CLAUDE_PROJECT_DIR}/core/hooks/run checks/heredoc-gate.py"
            }
          ]
        },
        {
          "matcher": "Edit|Write|ApplyPatch",
          "hooks": [
            {
              "type": "command",
              "timeout": 60,
              "command": "sh ${CLAUDE_PROJECT_DIR}/core/hooks/run checks/pre-edit.py"
            },
            {
              "type": "command",
              "timeout": 60,
              "command": "sh ${CLAUDE_PROJECT_DIR}/core/hooks/run facade/facade-scan.py"
            },
            {
              "type": "command",
              "timeout": 60,
              "command": "sh ${CLAUDE_PROJECT_DIR}/core/hooks/run facade/facade-gate.py"
            },
            {
              "type": "command",
              "timeout": 30,
              "command": "sh ${CLAUDE_PROJECT_DIR}/core/hooks/run checks/issues-gate.py"
            },
            {
              "type": "command",
              "timeout": 30,
              "command": "sh ${CLAUDE_PROJECT_DIR}/core/hooks/run read/spec-read-gate.py"
            }
          ]
        },
        {
          "matcher": "Read",
          "hooks": [
            {
              "type": "command",
              "timeout": 30,
              "command": "bash ${CLAUDE_PROJECT_DIR}/core/hooks/read/pre-read.sh"
            }
          ]
        },
        {
          "matcher": "Agent|Task",
          "hooks": [
            {
              "type": "command",
              "timeout": 30,
              "command": "sh ${CLAUDE_PROJECT_DIR}/core/hooks/run read/agent-context.py"
            }
          ]
        }
      ],
      "PostToolUse": [
        {
          "matcher": "Edit|Write|ApplyPatch",
          "hooks": [
            {
              "type": "command",
              "timeout": 120,
              "command": "bash ${CLAUDE_PROJECT_DIR}/core/hooks/post-edit.sh"
            }
          ]
        },
        {
          "matcher": "Read",
          "hooks": [
            {
              "type": "command",
              "timeout": 30,
              "command": "sh ${CLAUDE_PROJECT_DIR}/core/hooks/run facade/facade-tracker.py"
            },
            {
              "type": "command",
              "timeout": 30,
              "command": "sh ${CLAUDE_PROJECT_DIR}/core/hooks/run read/context-tracker.py"
            }
          ]
        }
      ],
      "UserPromptSubmit": [
        {
          "hooks": [
            {
              "type": "command",
              "timeout": 30,
              "command": "sh ${CLAUDE_PROJECT_DIR}/core/hooks/run session/context-meter.py"
            }
          ]
        }
      ],
      "SessionStart": [
        {
          "matcher": "^compact$",
          "hooks": [
            {
              "type": "command",
              "timeout": 30,
              "command": "bash ${CLAUDE_PROJECT_DIR}/core/hooks/session/precompact-wipe.sh"
            }
          ]
        },
        {
          "hooks": [
            {
              "type": "command",
              "timeout": 30,
              "command": "bash ${CLAUDE_PROJECT_DIR}/core/hooks/session/session-prune.sh"
            },
            {
              "type": "command",
              "timeout": 30,
              "command": "sh ${CLAUDE_PROJECT_DIR}/core/hooks/run git/branch_marker.py record"
            },
            {
              "type": "command",
              "timeout": 30,
              "command": "sh ${CLAUDE_PROJECT_DIR}/core/hooks/run session/inbox-nudge.py"
            },
            {
              "type": "command",
              "timeout": 30,
              "command": "sh ${CLAUDE_PROJECT_DIR}/core/hooks/run session/compass-nudge.py"
            }
          ]
        }
      ]
    }
  }
}
