# Usage: core/run tools/delegate/ask [--out FILE] [--only NAME] [--role ROLE | --debate] PROMPT_FILE|- | --list | --check — ask an outside panel (another vendor's model), falling to the next model when one gives no verdict
#
# WHY THIS EXISTS: AGENTS.md puts an outside panel's verdict next to every option Lucas decides,
# and each session rebuilt the call by hand (2026-11-04: three manual tries before the first
# verdict). Who is in the chain, and in which order, is core/workers.txt; the call itself is
# core/tools/workers.py, shared with describe.py.
#
# WHY READ-ONLY: a panel comments, it never edits. The spawner writes files from the answer.
#
# WHY EVERY MISS FALLS THROUGH: a spent quota and a broken call both gave no verdict, and the next
# model's verdict is worth more than a stop. Each miss is printed with its class, so a broken call
# is never mistaken for a spent quota.
#
# WHY A DEBATE NEEDS THREE VENDORS: two models of one vendor are one voice (argon and flash are
# both google). --debate gives advocate, opponent and mediator to three distinct vendors or stops.
import argparse
import datetime
import pathlib
import sys

sys.path.insert(0, str(pathlib.Path(__file__).resolve().parents[1]))
import tool_law  # noqa: E402
import workers  # noqa: E402

tool_law.require('delegate')

ROLES = {
    'advocate': 'Argue FOR the proposal below as strongly as the evidence allows; name its best case.',
    'opponent': 'Argue AGAINST the proposal below: the strongest objections, risks and failure cases.',
    'mediator': 'Two experts argued opposite sides below. Weigh both, say who is right on each point, '
                'and give one verdict with its biggest remaining risk.',
    'summarizer': 'Summarize the material below for a decision-maker: what is settled, what is open.',
}


def framed(prompt: str, role: str) -> str:
    return prompt if role == '-' else f'{ROLES[role]}\n\n{prompt}'


def ask(prompt: str, rows=None, caller=workers.call, role: str = '-', skip_vendors=()):
    """The first verdict down the chain: (result, misses). SystemExit when none answered."""
    misses = []
    for row in rows if rows is not None else workers.chain():
        if row['vendor'] in skip_vendors:
            continue
        r = caller(row['worker'], framed(prompt, role), role)
        if r.status == 'ok':
            return r, row, misses
        misses.append(f'{r.worker}: {r.status}: {r.text[-160:]}')
    raise SystemExit('panel: no model answered\n  ' + '\n  '.join(misses))


def debate(prompt: str, rows=None, caller=workers.call):
    """Advocate, opponent and mediator, each from a vendor the others are not."""
    """A role nobody filled is named, never fatal: the answers already paid for are kept (2026-11-24,
    a hung deepseek cost the whole debate). Only a debate with no answer at all stops."""
    used, parts, missing = [], [], []
    for role in ('advocate', 'opponent', 'mediator'):
        text = prompt if role != 'mediator' else '\n\n'.join(parts) + f'\n\n## The proposal\n{prompt}'
        try:
            r, row, _ = ask(text, rows, caller, role, used)
        except SystemExit as miss:
            missing.append(role)
            parts.append(f'## {role} — missing\n{miss}')
            continue
        used.append(row['vendor'])
        parts.append(f'## {role} ({r.worker} {r.model})\n{r.text}')
    if not used:
        raise SystemExit('panel: no model answered the debate\n' + '\n'.join(parts))
    return f'debate: {", ".join(used)}' + (f' (missing: {", ".join(missing)})' if missing else ''), '\n\n'.join(parts) + '\n'


def listing() -> int:
    stats, offers = workers.tally(), {}
    print('worker\tharness\tvendor\tlevel\tchain\tid\tquota\tlive\tcalls\tok\tmedian_s\tcost\tcall_verified\tstrength\tweakness')
    for r in workers.catalog():
        n, ok, med = stats.get(r['worker'], (0, 0.0, 0))
        quota = f'depleted {r["depleted"]}' if r['depleted'] != '-' else (
            f'cooling since {since}' if (since := workers.cooling(r['worker'])) else '-')
        print('\t'.join([r['worker'], r['harness'], r.get('vendor', '?'), r['level'], r['chain'],
                         r['id'], quota, workers.live(r, offers), str(n),
                         f'{ok:.0%}' if n else '-', f'{med:g}' if n else '-', r['cost'],
                         r['call_verified'], r.get('strength', '?'), r.get('weakness', '?')]))
    return 0


def check() -> int:
    """Silent when every declared worker is reachable and still offered — core/periodicos.txt runs
    it at every close, and a periodic job speaks only when it has news."""
    offers = {}
    bad = [f'{r["worker"]}: {state}' for r in workers.catalog()
           if (state := workers.live(r, offers)) not in ('ok', 'host')]
    bad += [f'{r["worker"]}: model {r["model"]} is not in core/models.txt'
            for r in workers.catalog() if 'vendor' not in r]
    if bad:
        print('workers: fix core/workers.txt —\n' + '\n'.join(bad), file=sys.stderr)
    return 1 if bad else 0


def main() -> int:
    names = [r['worker'] for r in workers.catalog()]
    p = argparse.ArgumentParser(description='Ask an outside panel; the next model when one gives no verdict.')
    p.add_argument('prompt', nargs='?', help='prompt file, or - for stdin')
    p.add_argument('--out', help='write the answer here, headed by who answered and when')
    p.add_argument('--only', choices=names, help='ask this worker alone, in the chain or not')
    p.add_argument('--role', choices=sorted(ROLES), default='-')
    p.add_argument('--debate', action='store_true', help='advocate, opponent, mediator: three vendors')
    p.add_argument('--list', action='store_true', help='every worker: catalog, live check, call stats')
    p.add_argument('--check', action='store_true', help='exit 1 when a declared worker is gone')
    a = p.parse_args()
    if a.list:
        return listing()
    if a.check:
        return check()
    if not a.prompt:
        p.error('a prompt file, or - for stdin')
    prompt = sys.stdin.read() if a.prompt == '-' else pathlib.Path(a.prompt).read_text(encoding='utf-8')
    rows = [r for r in workers.catalog() if r['worker'] == a.only] if a.only else None
    if a.debate:
        who, answer = debate(prompt, rows)
    else:
        r, _, misses = ask(prompt, rows, role=a.role)
        for m in misses:
            print(f'panel: skipped {m}', file=sys.stderr)
        who, answer = f'{r.worker} {r.model}', r.text + '\n'
    text = f"<!-- panel: {who} · {datetime.datetime.now():%Y-%m-%d %H:%M} -->\n{answer}"
    if a.out:
        pathlib.Path(a.out).write_text(text, encoding='utf-8', newline='\n')
        print(f'panel: {who} answered → {a.out}', file=sys.stderr)
    else:
        sys.stdout.write(text)
    return 0


if __name__ == '__main__':
    sys.exit(main())
