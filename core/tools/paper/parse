# Usage: core/tools/paper/parse <file> [--md] — extract readable text or markdown from DOCX, PPTX, HTML, or plain text files; a PDF is refused toward core/run tools/pdf/docling
import sys, json, pathlib, subprocess, argparse

sys.path.insert(0, str(pathlib.Path(__file__).resolve().parents[1]))
import tool_law  # noqa: E402

# A PDF gets a twin, not a text dump: all text, every figure described, a hash that says when it went
# stale (core/tools/pdf/CONTEXT.md). The pdftotext + tesseract path that lived here lost tables,
# figures and accents, and two readers of one format is how they drift apart.
PDF_REFUSAL = ('a PDF is read through its twin, not parsed here. Make or refresh it with:\n'
               '  core/run tools/pdf/docling {path}\n'
               'and read the .md whose path that command prints')


def _pandoc(path, fmt='plain'):
    r = subprocess.run(['pandoc', '-t', fmt, str(path)], capture_output=True, text=True, encoding='utf-8')
    if r.returncode != 0:
        return None, r.stderr
    return r.stdout, None

def main():
    tool_law.require('latex')  # before argparse: off means off.
    p = argparse.ArgumentParser()
    p.add_argument('file')
    p.add_argument('--md', action='store_true', help='output as markdown where supported')
    args = p.parse_args()

    path = pathlib.Path(args.file)
    if not path.exists():
        print(json.dumps({'error': f'file not found: {args.file}'}), file=sys.stderr)
        sys.exit(1)

    ext = path.suffix.lower()
    fmt = 'gfm' if args.md else 'plain'
    if ext == '.pdf':
        print(json.dumps({'error': PDF_REFUSAL.format(path=path)}), file=sys.stderr)
        sys.exit(1)
    elif ext in ('.docx', '.doc', '.pptx', '.ppt', '.odt', '.rtf', '.html', '.htm'):
        text, err = _pandoc(path, fmt=fmt)
    elif ext in ('.txt', '.md', '.tex', '.csv', '.json', '.yaml', '.yml'):
        text, err = path.read_text(errors='replace', encoding='utf-8'), None
    else:
        print(json.dumps({'error': f'unsupported format: {ext}'}), file=sys.stderr)
        sys.exit(1)

    if err:
        print(json.dumps({'error': err}), file=sys.stderr)
        sys.exit(1)
    print(text)

if __name__ == '__main__':
    main()
