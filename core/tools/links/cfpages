# Usage: core/run tools/links/cfpages <cmd> [args] — named short links: add, find, rm, build, check; publish a course page
import argparse
import json
import pathlib
import re
import subprocess
import sys
import unicodedata
import urllib.request

_HERE = pathlib.Path(__file__).resolve().parent
sys.path.insert(0, str(_HERE))
sys.path.insert(0, str(_HERE.parent))
import tool_law  # noqa: E402

tool_law.require('link-shortener')

import links_core  # noqa: E402
import pages  # noqa: E402

ROOT = _HERE.parents[2]
# Under outputs/ and not code/: it holds no source, only what `build` regenerates from links.txt,
# and code/ is for software projects — which is exactly the scope the Git Flow branch gate covers.
# Losing this clone costs one `gh repo clone`; the map it is built from is the versioned half.
PUBLISH = ROOT / 'outputs' / 'links'
PROJECT = 'lucassf'  # the Cloudflare Pages project serving lucassf.pages.dev

# The published site is redirects and nothing else. An index listing every short name would hand a
# stranger the whole map, which is the one thing the private-subtree refusal exists to prevent —
# so the root is a dead end on purpose.
INDEX = "<!doctype html><meta charset=utf-8><title>lsf</title><p>Nothing to see here.\n"


def cmd_add(short_name: str, url: str, owner: str, home: str) -> None:
    row = links_core.add(short_name, url, owner=owner, home=home)
    print(f"{links_core.base()}/{row['short_name']}  ->  {row['url']}")
    print(f"  owner: {row['owner']}   added: {row['added']}")
    print(f"  not live until: core/run tools/links/cfpages build --push")


def cmd_find(term: str) -> None:
    rows = links_core.find(term) if term else links_core.load()
    for r in rows:
        print(f"{links_core.base()}/{r['short_name']}\t{r['url']}\t{r['owner']}\t{r['added']}")
    print(f"── {len(rows)} short name(s)", file=sys.stderr)


def cmd_rm(short_name: str) -> None:
    row = links_core.remove(short_name)
    print(f"Removed {row['short_name']} (was {row['url']})")
    print(f"  still live until: core/run tools/links/cfpages build --push")


def cmd_pull(publish: pathlib.Path) -> None:
    """Browser edits and student deliveries come home, and are committed alone, by path."""
    written = pages.pull(publish)
    if not written:
        return
    # a course lives in its own repo (academy/teaching is one), so each file commits where it is tracked
    repos: dict[str, list[str]] = {}
    for p in written:
        print(f"from the site: {p.relative_to(ROOT)}")
        top = subprocess.run(['git', 'rev-parse', '--show-toplevel'], cwd=p.parent,
                             capture_output=True, text=True, encoding='utf-8', check=True).stdout.strip()
        repos.setdefault(top, []).append(str(p))
    for top, paths in repos.items():
        # by path: another session may hold staged work in the same index (code/SPECS-git.md)
        subprocess.run(['git', 'add', '--', *paths], cwd=top, check=True)
        done = subprocess.run(['git', 'commit', '-q', '-m', 'chore(links): edits made on the site come home',
                               '--', *paths], cwd=top)
        if done.returncode:
            print(f"  written but NOT committed in {top} — the commit gate refused; commit by hand", file=sys.stderr)


def _env(path: pathlib.Path) -> dict:
    lines = path.read_text(encoding='utf-8').splitlines() if path.exists() else []
    return dict(l.split('=', 1) for l in lines if '=' in l and not l.startswith('#'))


def cmd_secrets(push: bool) -> None:
    """The site's secrets, assembled from the workspace's segredos.env files — the workspace owns them,
    the host only holds a copy. TURMAS pairs each name under a page's "## entregue" with the
    MATRICULA_<NAME> line of that course's segredos.env (accents, dots and spaces folded)."""
    own = _env(_HERE / 'segredos.env')
    turmas = {}
    for page in sorted(pages.CLASSES.glob('*/disciplina.md')):
        env = _env(page.parent / 'segredos.env')
        section = page.read_text(encoding='utf-8').partition('## entregue')[2].split('\n## ')[0]
        names = re.findall(r'^- \*\*(.+?)\*\* \|', section, re.M)
        if not names or not env:
            continue
        key = lambda n: 'MATRICULA_' + re.sub(r'\W+', '_', unicodedata.normalize('NFKD', n).encode('ascii', 'ignore').decode()).strip('_').upper()
        missing = [n for n in names if key(n) not in env]
        if missing:
            raise SystemExit(f"{page.parent.name}: no {', '.join(key(n) for n in missing)} in segredos.env")
        duplas = [d.split('+') for d in env.get('DUPLAS', '').split(',') if d]
        turmas[page.parent.name] = {'matriculas': {n: env[key(n)].strip() for n in names}, 'duplas': duplas}
    values = {'EDIT_PASSWORD': own.get('EDIT_PASSWORD', ''), 'GITHUB_TOKEN': own.get('GITHUB_TOKEN', ''),
              'TURMAS': json.dumps(turmas, ensure_ascii=False)}
    if not push:
        print("# paste each into the host's secret store, or rerun with --push")
        for k, v in values.items():
            print(f"{k}={v}")
        return
    # Cloudflare Pages reads secrets at deploy time: set them, then redeploy the production branch.
    api = f"https://api.cloudflare.com/client/v4/accounts/{own['CLOUDFLARE_ACCOUNT']}/pages/projects/{PROJECT}"
    def call(method: str, url: str, body: dict | None = None) -> dict:
        req = urllib.request.Request(url, method=method, data=json.dumps(body).encode() if body else None,
                                     headers={'Authorization': f"Bearer {own['CLOUDFLARE_TOKEN']}",
                                              'Content-Type': 'application/json'})
        with urllib.request.urlopen(req) as res:
            return json.loads(res.read().decode('utf-8'))
    env_vars = {k: {'type': 'secret_text', 'value': v} for k, v in values.items()}
    call('PATCH', api, {'deployment_configs': {'production': {'env_vars': env_vars}}})
    print(f"set {', '.join(values)} on {PROJECT}")
    call('POST', f"{api}/deployments")
    print("  redeploying — live in ~1 min")


def cmd_build(publish: pathlib.Path, push: bool) -> None:
    rows = links_core.load()
    findings = links_core.check(rows)
    if findings:
        # A broken map must never reach the site: a bad row here is a link handed to a room.
        print("Refusing to build — the map has findings:", file=sys.stderr)
        for f in findings:
            print(f"  {f}", file=sys.stderr)
        raise SystemExit(1)
    if not publish.exists():
        raise SystemExit(
            f"{publish} does not exist.\n"
            f"  It is the publish repo — create it, then rerun:\n"
            f"    gh repo create lsf-links --public --clone {publish}"
        )
    if push:
        cmd_pull(publish)  # a push behind the site is refused, and a browser edit would be lost
    (publish / '_redirects').write_text(links_core.redirects(rows), encoding="utf-8", newline="\n")
    (publish / 'index.html').write_text(INDEX, encoding="utf-8", newline="\n")
    print(f"Wrote {len(rows)} redirect(s) to {publish}/_redirects")
    if not push:
        print("  --push to commit and deploy")
        return
    pages.push(publish, ['_redirects', 'index.html'], f'{len(rows)} redirects')
    print(f"  pushed — Cloudflare Pages deploys in ~30s, then {links_core.base()}/<name> is live")


def cmd_publish(page: pathlib.Path, publish: pathlib.Path) -> None:
    cmd_pull(publish)  # before redraw and mirror, or the workspace copy lands over a browser edit
    for name in pages.redraw(page):
        print(f"redrew {page.name} with {name}")
    copied = pages.mirror(page, publish)
    course = copied[0].parent.name
    pages.push(publish, [publish / course], f"atualiza {course}/{page.stem}")
    main_target = copied[0]
    artefacts = copied[1:]
    if page.stem in ("disciplina", "index"):
        web_url = f"{links_core.base()}/{course}"
    else:
        web_url = f"{links_core.base()}/{course}/{page.stem}"
    raw_url = f"{links_core.base()}/{main_target.relative_to(publish).as_posix()}"
    print(f"web: {web_url} · raw: {raw_url}")
    if artefacts:
        print(f"artefatos: {len(artefacts)} sincronizado(s)")
    print("  pushed — Cloudflare Pages deploys in ~30s")


def cmd_check() -> None:
    findings = links_core.check(links_core.load())
    for f in findings:
        print(f)
    print(f"── {len(findings)} finding(s)", file=sys.stderr)
    raise SystemExit(1 if findings else 0)


def main():
    p = argparse.ArgumentParser(prog="cfpages")
    sub = p.add_subparsers(dest="cmd")

    pa = sub.add_parser("add")
    pa.add_argument("short_name", help="ai4good, or ai4good/setup — one level, sayable out loud")
    pa.add_argument("url")
    pa.add_argument("--owner", default="", help="what the short name belongs to (default: its first segment)")
    pa.add_argument("--for", dest="home", default="",
                    help="workspace path recording this link; branches/ is refused")

    pf = sub.add_parser("find")
    pf.add_argument("term", nargs="?", default="", help="matched against short_name, url and owner")

    pr = sub.add_parser("rm")
    pr.add_argument("short_name")

    pb = sub.add_parser("build")
    pb.add_argument("--dir", dest="publish", default=str(PUBLISH))
    pb.add_argument("--push", action="store_true", help="commit and push the publish repo")

    sub.add_parser("check")

    ps = sub.add_parser("secrets", help="print the site's secrets, built from the workspace's segredos.env files")
    ps.add_argument("--push", action="store_true", help="set them on the Pages project and redeploy")

    pl = sub.add_parser("pull", help="bring browser edits and student deliveries home; publish and build run it first")
    pl.add_argument("--dir", dest="publish", default=str(PUBLISH))

    pp = sub.add_parser("publish", help="redraw, mirror and push a course page and its artefatos/")
    pp.add_argument("page", help="academy/teaching/classes/<course>/<file>.md")
    pp.add_argument("--dir", dest="publish", default=str(PUBLISH))

    args = p.parse_args()
    try:
        if   args.cmd == "add":   cmd_add(args.short_name, args.url, args.owner, args.home)
        elif args.cmd == "find":  cmd_find(args.term)
        elif args.cmd == "rm":    cmd_rm(args.short_name)
        elif args.cmd == "build": cmd_build(pathlib.Path(args.publish), args.push)
        elif args.cmd == "check": cmd_check()
        elif args.cmd == "pull":  cmd_pull(pathlib.Path(args.publish))
        elif args.cmd == "secrets": cmd_secrets(args.push)
        elif args.cmd == "publish": cmd_publish(pathlib.Path(args.page), pathlib.Path(args.publish))
        else:                     p.print_help()
    except (links_core.Refused, pages.Refused) as e:
        # A refusal already names its own fix — printing a traceback over it buries the fix.
        print(e, file=sys.stderr)
        raise SystemExit(1)


if __name__ == "__main__":
    main()
