# Usage: core/run tools/audio/dictate <toggle|status|learn|test-inject> — desktop dictation CLI
from __future__ import annotations

import argparse
import fcntl
import json
import os
import pathlib
import shutil
import signal
import subprocess
import sys
import time

_HERE = pathlib.Path(__file__).resolve().parent
_ROOT = _HERE.parents[2]
if str(_HERE) not in sys.path:
    sys.path.insert(0, str(_HERE))

import config as stt_config  # noqa: E402
import ibus_inject  # noqa: E402
import learn as stt_learn  # noqa: E402
import refine  # noqa: E402
import stt  # noqa: E402


def _runtime_dir() -> pathlib.Path:
    override = os.environ.get("WOS_DICTATE_RUNTIME")
    if override:
        return pathlib.Path(override)
    return pathlib.Path(os.environ.get("XDG_RUNTIME_DIR") or f"/tmp/wos-stt-{os.getuid()}")


def _state_file() -> pathlib.Path:
    return _runtime_dir() / "wos-dictate.json"


def _pid_alive(pid: int) -> bool:
    try:
        os.kill(pid, 0)
        return True
    except OSError:
        return False


def _stop_recorder(pid: int, timeout: float = 2.0) -> None:
    for sig in (signal.SIGINT, signal.SIGTERM):
        try:
            os.killpg(pid, sig)
        except OSError:
            try:
                os.kill(pid, sig)
            except OSError:
                return
        if sig == signal.SIGTERM:
            return
        deadline = time.monotonic() + timeout
        while time.monotonic() < deadline:
            if not _pid_alive(pid):
                return
            time.sleep(0.05)


def _start_recording(state_path: pathlib.Path, polish: bool, no_ibus: bool, max_seconds: int) -> int:
    rt = _runtime_dir()
    rt.mkdir(parents=True, exist_ok=True)
    wav = rt / f"wos-dictate-{os.getpid()}.wav"
    cmd = ["timeout", "-s", "INT", str(max(10, int(max_seconds))),
           "pw-record", "--rate", "16000", "--channels", "1", "--format", "s16", str(wav)]
    proc = subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    payload = {"pid": proc.pid, "wav": str(wav), "started": time.time(), "polish": polish, "no_ibus": no_ibus}
    tmp = state_path.with_suffix(".tmp")
    tmp.write_text(json.dumps(payload), encoding="utf-8", newline="\n")
    os.replace(tmp, state_path)
    ibus_inject.set_state("recording")
    return 0


def _finish_recording(state: dict, state_path: pathlib.Path, polish_flag: bool, no_ibus_flag: bool, cfg: dict) -> int:
    pid, wav = int(state.get("pid", 0)), pathlib.Path(str(state.get("wav", "")))
    state_path.unlink(missing_ok=True)
    ibus_inject.set_state("transcribing")
    if pid > 0:
        _stop_recorder(pid)
    try:
        if not wav.is_file() or wav.stat().st_size < 512:
            ibus_inject.notify("Ditado vazio", "Nenhum áudio capturado", timeout_ms=1500)
            return 0
        vocab = refine.load_vocab()
        prompt = refine.build_prompt(vocab["carrier"], refine.load_aiwbot_carrier(), vocab["learned_terms"])
        raw = stt.run(wav, stt.model(), prompt, lang="pt")
        if not raw.strip():
            ibus_inject.notify("Ditado descartado", "Fala não reconhecida com confiança", timeout_ms=1800)
            return 0
        use_polish = polish_flag or bool(state.get("polish")) or bool(cfg.get("polish")) or os.environ.get("WOS_STT_POLISH") == "1"
        no_ibus = no_ibus_flag or bool(state.get("no_ibus")) or bool(cfg.get("no_ibus"))
        corrected = refine.refine_text(raw, vocab, use_polish=use_polish)
        refine.log_dictation(raw, corrected, source="desktop")
        print(f"[{ibus_inject.inject(corrected, use_ibus=not no_ibus)}] {corrected}")
        return 0
    finally:
        ibus_inject.set_state("idle")
        wav.unlink(missing_ok=True)


def cmd_toggle(polish: bool, no_ibus: bool) -> int:
    cfg, rt = stt_config.load_config(), _runtime_dir()
    rt.mkdir(parents=True, exist_ok=True)
    with (rt / "wos-dictate.lock").open("w", encoding="utf-8", newline="\n") as lfh:
        try:
            fcntl.flock(lfh.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            return 0
        sp = _state_file()
        if sp.is_file():
            try:
                state = json.loads(sp.read_text(encoding="utf-8"))
            except ValueError:
                sp.unlink(missing_ok=True)
                state = {}
            pid = int(state.get("pid") or 0)
            if pid > 0 and _pid_alive(pid):
                return _finish_recording(state, sp, polish, no_ibus, cfg)
            sp.unlink(missing_ok=True)
        return _start_recording(sp, polish, no_ibus, int(cfg.get("max_record_seconds", 300)))


def cmd_status() -> int:
    vocab, cfg, sp = refine.load_vocab(), stt_config.load_config(), _state_file()
    recording = False
    if sp.is_file():
        try:
            recording = _pid_alive(int(json.loads(sp.read_text(encoding="utf-8")).get("pid", 0)))
        except Exception:
            recording = False
    info = {
        "sttd_alive": stt.daemon_alive(), "ibus_alive": ibus_inject.ibus_alive(), "recording": recording,
        "shortcuts": cfg["shortcuts"], "idle_seconds": cfg["idle_seconds"],
        "max_record_seconds": cfg["max_record_seconds"],
        "replacements_count": len(vocab["replacements"]), "learned_terms_count": len(vocab["learned_terms"]),
    }
    print(json.dumps(info, ensure_ascii=False, indent=2))
    return 0


def cmd_copy_last() -> int:
    log_path = refine.state_dir() / "dictations.jsonl"
    if not log_path.is_file():
        print("Nenhum ditado registrado.", file=sys.stderr)
        return 1
    last_text = ""
    for line in reversed(log_path.read_text(encoding="utf-8", errors="replace").splitlines()):
        if not line.strip():
            continue
        try:
            row = json.loads(line)
            last_text = str(row.get("corrected") or row.get("raw") or "").strip()
            if last_text:
                break
        except ValueError:
            continue
    if not last_text:
        print("Nenhum ditado válido encontrado.", file=sys.stderr)
        return 1
    if shutil.which("wl-copy"):
        subprocess.run(["wl-copy"], input=last_text, text=True, encoding="utf-8", check=False)
        ibus_inject.notify("Último ditado copiado", last_text[:90], timeout_ms=2000)
    print(last_text)
    return 0


def cmd_apply_config(force: bool) -> int:
    cfg = stt_config.load_config()
    res = stt_config.apply_gnome_shortcuts(cfg["shortcuts"], f"{_ROOT / 'core' / 'run'} tools/audio/dictate toggle", force=force)
    if not res.get("ok"):
        print(json.dumps(res, ensure_ascii=False, indent=2), file=sys.stderr)
        return 1
    res["idle_unit_updated"] = stt_config.sync_systemd_idle(int(cfg["idle_seconds"]))
    res["restarted"] = []
    for unit in ("wos-stt.service", "wos-ibus.service"):
        if subprocess.run(["systemctl", "--user", "is-active", "--quiet", unit], check=False).returncode == 0:
            subprocess.run(["systemctl", "--user", "restart", unit], check=False, timeout=5.0)
            res["restarted"].append(unit)
    print(json.dumps(res, ensure_ascii=False, indent=2))
    return 0


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description="Desktop voice dictation CLI")
    sub = parser.add_subparsers(dest="cmd", required=True)
    tog = sub.add_parser("toggle")
    tog.add_argument("--polish", action="store_true")
    tog.add_argument("--no-ibus", action="store_true")
    sub.add_parser("status")
    sub.add_parser("copy-last")
    sub.add_parser("config")
    ap = sub.add_parser("apply-config")
    ap.add_argument("--force", action="store_true")
    lrn = sub.add_parser("learn")
    lrn.add_argument("--quiet", action="store_true")
    inj = sub.add_parser("test-inject")
    inj.add_argument("text")
    inj.add_argument("--no-ibus", action="store_true")
    args = parser.parse_args(argv)
    if args.cmd == "toggle":
        return cmd_toggle(args.polish, args.no_ibus)
    if args.cmd == "status":
        return cmd_status()
    if args.cmd == "copy-last":
        return cmd_copy_last()
    if args.cmd == "config":
        print(json.dumps({"default": str(stt_config.default_config_path()), "local": str(stt_config.local_config_path()),
                          "effective": stt_config.load_config()}, ensure_ascii=False, indent=2))
        return 0
    if args.cmd == "apply-config":
        return cmd_apply_config(args.force)
    if args.cmd == "learn":
        res = stt_learn.run()
        if not args.quiet or res.get("promoted", 0) > 0:
            print(json.dumps(res, ensure_ascii=False, indent=2))
        return 0
    if args.cmd == "test-inject":
        print(ibus_inject.inject(args.text, use_ibus=not args.no_ibus))
        return 0
    return 1


if __name__ == "__main__":
    raise SystemExit(main())
