#!/usr/bin/env bash
# Usage: core/tools/wos/roundup [--no-promote <reason>] [--leave-dirty] — the deterministic half of the /roundup ritual
# Verification gate, entropy regen, branch promotion. Prints the state facts /handoff copies and
# anything that needs a decision; nothing else.
#
# WHICH lines print is this file's business alone. The skills copy them and never name them: a
# label list in prose is a second copy that rots without failing anything, which is how both
# skills promised three lines while this printed six (fixed 2026-08-25).
#
# Same name as core/skills/roundup.md on purpose: one ritual, two layers. Judgment — what to delete,
# where knowledge goes, what the INBOX means — stays in the skill; everything with one right answer
# lives here, where it costs one tool call instead of prose reasoned about at the most expensive
# turns a session ever has (core/SPECS.md § AD-09). Lucas types /roundup; the skill calls this.
set -uo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
WORKSPACE="$(cd "$SCRIPT_DIR/../../.." && pwd)"

NO_PROMOTE=""
LEAVE_DIRTY=""
while [ $# -gt 0 ]; do
  case "$1" in
    --no-promote) NO_PROMOTE="${2:?--no-promote needs a reason}"; shift 2 ;;
    --leave-dirty) LEAVE_DIRTY=1; shift ;;
    *) echo "Usage: $0 [--no-promote <reason>] [--leave-dirty]" >&2; exit 64 ;;
  esac
done

ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || { echo "not a git repo: $PWD" >&2; exit 64; }
cd "$ROOT" || exit 64
BRANCH="$(git rev-parse --abbrev-ref HEAD)"

# ── Uncommitted work is the agent's call (a commit message is judgment), so stop. The one message
#    here naming two actions, because the question is binary and the script cannot answer it: dirt
#    may be this session's or a parallel session's. Asserting the first was the defect
#    — it asked for a commit that would have swept another session's half-done work into main.
DIRTY="$(git status --porcelain | wc -l)"
if [ "$DIRTY" -gt 0 ] && [ -z "$LEAVE_DIRTY" ]; then
  printf '%s uncommitted on %s — whose?\n' "$DIRTY" "$BRANCH"
  git status --short | head -20
  printf 'Yours: commit, then rerun.\nAnother session'"'"'s: rerun with --leave-dirty.\n'
  exit 2
fi

# ── Verification gate. Contract discovery is the convention from
#    core/hooks/commit/gates_project.py § 1a, one tier up: full if declared, else fast.
VERIFY_CMD=""
if   [ -f package.json ] && grep -q '"verify:full"' package.json; then VERIFY_CMD="npm run --silent verify:full"
elif [ -f Makefile ]     && grep -qE '^verify-full:' Makefile;     then VERIFY_CMD="make verify-full"
elif [ -f package.json ] && grep -q '"verify:fast"' package.json; then VERIFY_CMD="npm run --silent verify:fast"
elif [ -f Makefile ]     && grep -qE '^verify-fast:' Makefile;     then VERIFY_CMD="make verify-fast"
fi

LOG="$(mktemp)"
trap 'rm -f "$LOG"' EXIT
if [ -z "$VERIFY_CMD" ]; then
  VERIFY="no contract"
elif $VERIFY_CMD >"$LOG" 2>&1; then
  COUNT="$(grep -oE '[0-9]+ passed' "$LOG" | tail -1)"
  VERIFY="green${COUNT:+ ($COUNT)}"
else
  VERIFY="red"
fi

# ── The two generated blocks in ISSUES.md — the workspace's own answer to what is currently untrue.
#    Workspace repo only: the dashboard scans the whole tree, nested repos included. Both blocks
#    land in one file, so they are settled once, in one commit.
. "$SCRIPT_DIR/close/artifacts.sh"

#    The count AND how it moved are both read out of the header the dashboard just wrote.
#    entropy_trend.py derives that trend from git every run; roundup used to compute a second delta
#    of its own, against the session immediately before it — where the delta really is +-1. That is
#    how "flat" got written into hand-off after hand-off while the real number climbed 95 -> 645.
#    Matched to the closing stars, never at the word: the header says "**N findings here**", and a
#    pattern anchored on "findings**" silently printed no entropy line at all (fixed 2026-08-25).
findings() { grep -oE '\*\*[0-9]+ findings[^*]*\*\*( \([^)]*\))?' ISSUES.md 2>/dev/null | head -1 | tr -d '*'; }
ENTROPY=""
if [ "$ROOT" = "$WORKSPACE" ]; then
  WAS_CLEAN=0; git diff --quiet ISSUES.md 2>/dev/null && WAS_CLEAN=1
  verify_block
  if make entropy >/dev/null 2>&1; then
    ENTROPY="$(findings)"
    ENTROPY="$ENTROPY$(settle ISSUES.md "$WAS_CLEAN" "chore(issues): regenerate the entropy and verify blocks at session close")"
  else
    ENTROPY="regen failed"
  fi
fi

# ── The workspace picture. Same scope and same shape as the entropy step above: workspace repo
#    only, regenerate then commit, and under --leave-dirty report without writing into another
#    session's tree. Deterministic output is what makes this safe to run every close — the file
#    moves when the WORKSPACE moved, never merely because it was regenerated.
DIAGRAM=""
if [ "$ROOT" = "$WORKSPACE" ]; then
  WAS_CLEAN=0; git diff --quiet ARCHITECTURE.html 2>/dev/null && WAS_CLEAN=1
  if DIAGRAM_OUT="$("$SCRIPT_DIR/diagram/architecture" 2>&1)"; then
    DIAGRAM="$(printf '%s' "$DIAGRAM_OUT" | grep -oE 'parsed [0-9]+ of [0-9]+ routing blocks.*' | head -1)"
  else
    DIAGRAM="regen incomplete · $(printf '%s' "$DIAGRAM_OUT" | grep -c UNPARSED) unparsed routing block(s)"
  fi
  DIAGRAM="$DIAGRAM$(settle ARCHITECTURE.html "$WAS_CLEAN" "chore(diagram): regenerate at session close")"
fi

# ── Branch promotion. Same scope as core/hooks/git/gitflow_gate.py: the workspace repo and
#    code/* project repos promote; every other nested repo just pushes its current branch.
case "$ROOT" in
  "$WORKSPACE"|"$WORKSPACE"/code/*) GITFLOW=1 ;;
  *) GITFLOW=0 ;;
esac
git fetch --quiet 2>/dev/null || true

behind_remote() { [ "$(git rev-list --count "$1..origin/$1" 2>/dev/null || echo 0)" -gt 0 ]; }

promote() {  # feature → develop → main, each pushed; abort the whole thing on the first conflict
  local target source
  for pair in "develop $BRANCH" "main develop"; do
    set -- $pair; target="$1"; source="$2"
    git rev-parse --verify -q "$target" >/dev/null || continue
    [ "$target" = "$source" ] && continue
    if behind_remote "$target"; then
      SYNC="$target is behind origin — a parallel session is mid-flight; not promoted"
      return 1
    fi
    # A fast-forward needs no checkout, so it never touches the working tree — which is what
    # makes promoting past another session's dirt safe. Only a real merge needs HEAD to move.
    if [ "$target" != "$BRANCH" ] && git merge-base --is-ancestor "$target" "$source" 2>/dev/null; then
      git fetch -q . "$source:$target" || { SYNC="fast-forward of $target failed; not promoted"; return 1; }
    elif [ -n "$LEAVE_DIRTY" ] && [ "$target" != "$BRANCH" ]; then
      SYNC="$target needs a real merge — not promoted while the tree holds another session's work"
      return 1
    else
      git checkout -q "$target" || { SYNC="checkout of $target failed; not promoted"; return 1; }
      if ! git merge --no-edit -q "$source" >/dev/null 2>&1; then
        git merge --abort 2>/dev/null
        git checkout -q "$BRANCH"
        SYNC="conflict merging $source → $target — aborted, branches untouched"
        return 1
      fi
      git checkout -q "$BRANCH"
    fi
    git push -q origin "$target" 2>/dev/null || { SYNC="$target merged but push failed"; return 1; }
  done
  return 0
}

SYNC=""
RC=0
git push -q origin "$BRANCH" 2>/dev/null || true   # post-commit already does this for feature/*
if [ "$VERIFY" = "red" ]; then
  SYNC="not promoted — verify red. $BRANCH pushed only"
  RC=1
elif [ -n "$NO_PROMOTE" ]; then
  SYNC="not promoted — $NO_PROMOTE. $BRANCH pushed only"
elif [ "$GITFLOW" = "0" ]; then
  SYNC="$BRANCH pushed (repo outside gitflow scope — no merges)"
elif ! promote; then
  RC=1
fi

if [ -z "$SYNC" ]; then
  SHAS=""
  for b in main develop "$BRANCH"; do
    git rev-parse --verify -q "$b" >/dev/null || continue
    SHAS="$SHAS $b@$(git rev-parse --short "$b")"
  done
  UNPUSHED="$(git for-each-ref --format='%(refname:short)%(upstream:track)' refs/heads | grep -c 'ahead' || true)"
  SYNC="promoted ·${SHAS} ·$([ "$UNPUSHED" = "0" ] && echo " all pushed" || echo " $UNPUSHED branch(es) unpushed")"
fi

# ── What this session cost, and whether compaction ran (a wiring job, not a
#    new instrument). The script has no session id, so resolve it the only way available: the
#    newest transcript under this repo's project slug is this session, and its stem is the id that
#    both `usage --session` and the compaction counter are keyed by. Both are best-effort —
#    a session-close must never fail because a report did.
SLUG="$(printf '%s' "$ROOT" | sed 's|/|-|g')"
SID="$(ls -t "$HOME/.claude/projects/$SLUG"/*.jsonl 2>/dev/null | head -1 | xargs -r basename | sed 's/\.jsonl$//')"
COST=""; COMPACT=""
SIZE="$("$SCRIPT_DIR/size" ${SID:+--session "$SID"} 2>/dev/null)" || SIZE=""
if [ -n "$SID" ]; then
  COST="$("$SCRIPT_DIR/session/usage" --session "$SID" 2>/dev/null)" || COST=""
  TSV="/tmp/claude_rtk_compact_$SID.tsv"
  # Adoption, not savings: rtk gain measures the tokens saved, this measures whether the shim is
  # reaching the commands at all. A flat 0% here is what the multi-line bug looked like.
  [ -s "$TSV" ] && COMPACT="$(awk -F'\t' '{n++} $1 ~ /rewrote/ {r++} END {
    printf "%d%% of %d bash calls rewritten", (r*100)/n, n}' "$TSV")"
fi

# What the session cost and whether the workspace shrank lead, because they are the two facts
# Lucas reads the block for; the rest is state the next session needs. Ruled 2026-08-25 — cost
# printed fifth and was read last.
[ -n "$COST" ] && printf '%s\n' "$COST"
[ -n "$SIZE" ] && printf '%s\n' "$SIZE"
printf 'verify: %s\n' "$VERIFY"
printf 'sync: %s\n' "$SYNC"
[ -n "$ENTROPY" ] && printf 'entropy: %s\n' "$ENTROPY"
[ -n "$DIAGRAM" ] && printf 'diagram: %s\n' "$DIAGRAM"
[ -n "$COMPACT" ] && printf 'compaction: %s\n' "$COMPACT"
[ "$VERIFY" = "red" ] && { echo "--- verify tail ---"; tail -20 "$LOG"; }
exit $RC
