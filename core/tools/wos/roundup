# Usage: core/tools/wos/roundup [--draft] [--session ID] — the session close: every repo this session holds goes back to develop.
#
# The deterministic half of the /roundup ritual (core/skills/roundup.md). For each repo the branch
# lock (core/hooks/git/lock.py) says this session holds:
#   dirty                         → exit 2 before touching anything: a commit message is judgment
#   origin/develop merged in first, so the suite judges what develop will hold
#   fast suite green, no --draft  → push that exact commit as develop
#   red, or --draft               → push the feature only
#   push confirmed                → switch to develop and drop the lock; a failed push keeps it
# First, what core/periodicos.txt asks of the trees held runs and speaks only when it has news.
# `main` never moves here: only an explicit release moves it. Nothing is committed by the close.
import argparse
import os
import shlex
import subprocess
import sys
from datetime import datetime
from pathlib import Path

sys.dont_write_bytecode = True   # a tool that judges a tree may not dirty it first
ROOT = Path(__file__).resolve().parents[3]
# This machine's close reports; a test points it at its own tmp_path (b20261120-roundup-test-state-leak).
STATE = Path(os.environ.get('WOS_STATE_DIR') or ROOT / 'outputs/state')
sys.path[:0] = [str(ROOT / 'core/hooks/git'), str(ROOT / 'core/hooks'), str(ROOT / 'core/tools/verify')]
import contract  # noqa: E402
import lock  # noqa: E402
from lock import git, out  # noqa: E402


def pushed(repo: Path, branch: str) -> bool:
    """Push, then confirm origin holds exactly what this clone holds."""
    if git(repo, 'push', '-q', '-u', 'origin', branch).returncode != 0:
        return False
    return out(repo, 'rev-parse', f'origin/{branch}') == out(repo, 'rev-parse', branch)


def verify(repo: Path) -> tuple:
    """(green, label, log). A repo with no contract has nothing to fail: green."""
    declared = contract.discover(repo, 'fast')
    if not declared:
        return True, 'no contract', ''
    code, log = contract.run(repo, declared)
    counts = ' · '.join(line.strip() for line in log.splitlines() if ' passed' in line)
    return code == 0, f'{declared[0]}: {counts or ("green" if code == 0 else "red")}', log


def integrate(repo: Path, branch: str) -> str:
    """Merge origin/develop into the feature, so the suite judges what develop will hold
    (b20261110-verify-not-merge-result). '' on success, else why not."""
    git(repo, 'fetch', '-q', 'origin')
    base = 'origin/develop' if out(repo, 'rev-parse', '--verify', '-q', 'origin/develop') else 'develop'
    if out(repo, 'rev-list', '--count', f'{base}..develop') not in ('', '0'):
        return 'local develop has commits origin lacks'
    if git(repo, 'merge', '-q', '--no-edit', base).returncode != 0:
        git(repo, 'merge', '--abort')
        return f'{branch} conflicts with develop'
    return ''


def close(repo: Path, session: str, draft: bool) -> tuple:
    """(line, code) for one held repo, already known clean."""
    lock.verdict(repo, session)   # follow a switch no write has seen yet
    name = lock.holder(repo)[1]
    if name in lock.SHARED or out(repo, 'branch', '--show-current') != name:
        # A claim records the branch it found; closing `develop` as a feature deletes it (2026-11-19).
        return f'{repo}: held on {name}, not a feature — switch to one before closing. Still held', 1
    refused = integrate(repo, name)
    if refused:
        return f'{repo}: not merged — {refused}. Still held on {name}', 1
    green, label, log = verify(repo)
    STATE.mkdir(parents=True, exist_ok=True)
    (STATE / f'verify-{lock.lock_file(repo).stem[5:]}.md').write_text(
        f'{datetime.now():%Y-%m-%d %H:%M} {"green" if green else "red"} — {label}\n'
        + ('' if green else '\n'.join(log.splitlines()[-20:]) + '\n'), encoding='utf-8', newline='\n')
    tested = out(repo, 'rev-parse', 'HEAD')
    if green and not draft:
        # Push the exact commit the suite judged; origin refuses it if develop moved meanwhile.
        if git(repo, 'push', '-q', 'origin', f'{tested}:refs/heads/develop').returncode != 0 or \
                out(repo, 'rev-parse', 'origin/develop') != tested:
            return f'{repo}: push of develop failed — origin moved? Close again. Still held on {name}', 1
        git(repo, 'switch', '-q', 'develop')
        git(repo, 'merge', '-q', '--ff-only', tested)
        git(repo, 'branch', '-q', '-D', name)
        git(repo, 'push', '-q', 'origin', '--delete', name)
        lock.release(repo, session)
        return f'{repo}: {name} merged into develop and pushed ({label})', 0
    if not pushed(repo, name):
        return f'{repo}: push of {name} failed. Still held', 1
    git(repo, 'switch', '-q', 'develop')
    lock.release(repo, session)
    why = 'draft' if green else 'verify red'
    # This line is what the handoff carries: the next session starts from a develop that lacks this work.
    return (f'{repo}: {name} pushed, not merged — {why} ({label}). HANDOFF: develop lacks this work; '
            f'ask Lucas before resuming {name}'), 0 if green else 1


def periodic(held: list) -> None:
    """Run what core/periodicos.txt asks of the trees these repos hold; print, never fail the close."""
    table = ROOT / 'core/periodicos.txt'
    rows = [l.split('\t') for l in table.read_text(encoding='utf-8').splitlines()[1:]
            if l.strip() and not l.startswith('#')] if table.exists() else []
    for tree, command, days in (r for r in rows if len(r) == 3 and r[0] != 'tree'):
        where = (ROOT / tree).resolve()
        # The repo that owns the tree, not any ancestor: holding the root never runs a nested repo's job.
        if (lock.repo_of(where) or where) not in {Path(r).resolve() for r in held}:
            continue
        argv = shlex.split(command.replace('{days}', days.strip()))
        argv = [sys.executable] + argv if argv[0].endswith('.py') else argv
        done = subprocess.run(argv, cwd=where, capture_output=True, text=True, encoding='utf-8')
        if (said := (done.stdout + done.stderr).strip()):
            print(f'periodic: {tree}\n{said}')


def main() -> int:
    parser = argparse.ArgumentParser(description='the session close')
    parser.add_argument('--draft', action='store_true', help='push the feature, never merge')
    parser.add_argument('--session', default=lock.env_session())
    args = parser.parse_args()
    held = lock.held_by(args.session) if args.session else []
    if not held:
        print('roundup: this session holds no repo')
        return 0
    dirty = {repo: out(repo, 'status', '--porcelain') for repo in held}
    if any(dirty.values()):
        for repo, files in dirty.items():
            if files:
                print(f'dirty: {repo}\n{files}')
        return 2
    periodic(held)
    code = 0
    for repo in held:
        line, failed = close(repo, args.session, args.draft)
        print(line)
        code = code or failed
    return code


if __name__ == '__main__':
    sys.exit(main())
