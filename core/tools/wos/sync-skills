#!/usr/bin/env bash
# Usage: core/tools/wos/sync-skills [--check] — regenerate skill mirrors from core/skills/*.md
#
# Source of truth:  /mnt/workspace/core/skills/<name>.md
# Symlink mirrors (<name>/SKILL.md -> source):
#   /mnt/workspace/.opencode/skills/<name>/SKILL.md   (opencode)
#   /mnt/workspace/.claude/skills/<name>/SKILL.md     (Claude Code)
#   /mnt/workspace/.zcode/skills/<name>/SKILL.md      (ZCode)
# Command file copies (<name>.md — full copy of source, enables /<name> slash command):
#   /mnt/workspace/.claude/commands/<name>.md         (Claude Code slash commands)
#
# Excluded from mirroring: _template.md, *.original.md, CONTEXT.md
#
# Linux is case-sensitive — the source dir is `core` (lowercase).
# Never use `Core` in symlink targets.
#
# Usage:
#   core/tools/wos/sync-skills            # sync all mirrors + command files
#   core/tools/wos/sync-skills --check    # exit 1 if mirrors/command files are stale/broken/missing
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
WORKSPACE="$(cd "$SCRIPT_DIR/../../.." && pwd)"
SRC="$WORKSPACE/core/skills"
MIRRORS=(
  "$WORKSPACE/.opencode/skills"
  "$WORKSPACE/.claude/skills"
  "$WORKSPACE/.zcode/skills"
  "$WORKSPACE/.agents/skills"
)
COMMANDS_DIR="$WORKSPACE/.claude/commands"

# Split 2026-07-31 at 341 lines (the cap is 200). The seam was already visible in the
# behaviour: generating mirrors is a different job from validating frontmatter.
source "$SCRIPT_DIR/skills/mirror.sh"
source "$SCRIPT_DIR/skills/validate.sh"

case "${1:-sync}" in
  --check)
    rc=0
    validate_skills || rc=1
    validate_flows      || rc=1
    validate_flow_loops || rc=1
    validate_flow_dag   || rc=1
    validate_agents   || rc=1
    orphans check || rc=1
    for m in "${MIRRORS[@]}"; do check_mirror "$m" || rc=1; done
    check_commands || rc=1
    if [[ $rc -eq 0 ]]; then echo "OK: all mirrors and command files in sync"; fi
    exit $rc
    ;;
  sync|"")
    if ! validate_skills; then echo "✗ fix the invalid skill files above before syncing." >&2; exit 1; fi
    orphans prune
    for m in "${MIRRORS[@]}"; do sync_mirror "$m"; done
    sync_commands
    echo "Synced $(list_skills | wc -l) skills to ${#MIRRORS[@]} mirrors + command files."
    ;;
  *)
    echo "Usage: $0 [--check]" >&2
    exit 64
    ;;
esac
