#!/usr/bin/env bash
# Usage: core/tools/wos/sync-skills [--check] — regenerate skill mirrors from core/skills/*.md
#
# Source of truth:  core/skills/<name>.md   (paths below are workspace-relative)
# Generated COPIES, git-ignored, regenerated on install / edit / create / commit:
#   .opencode/skills/<name>/SKILL.md   (opencode)
#   .claude/skills/<name>/SKILL.md     (Claude Code)
#   .zcode/skills/<name>/SKILL.md      (ZCode)
#   .claude/commands/<name>.md         (Claude Code slash commands, links rebased)
#
# Excluded from mirroring: _template.md, *.original.md, CONTEXT.md
#
# Linux is case-sensitive — the source dir is `core` (lowercase).
#
# Usage:
#   sh core/tools/wos/sync-skills         # sync all mirrors + command files
#   sh core/tools/wos/sync-skills --check # exit 1 if mirrors/command files are stale/broken/missing
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
WORKSPACE="$(cd "$SCRIPT_DIR/../../.." && pwd)"
SRC="$WORKSPACE/core/skills"
HARNESSES_FILE="$WORKSPACE/core/harnesses.txt"
MIRRORS=()
COMMANDS_DIRS=()
while IFS=$'\t' read -r name sdir cdir; do
  [[ -z "$name" || "$name" == \#* ]] && continue
  MIRRORS+=("$WORKSPACE/$sdir")
  [[ -n "$cdir" && "$cdir" != "-" ]] && COMMANDS_DIRS+=("$WORKSPACE/$cdir")
done < "$HARNESSES_FILE"
# One commands mirror today (the row that declares cdir); the column is the declaration.
COMMANDS_DIR="${COMMANDS_DIRS[0]:-}"

# Split 2026-07-31 at 341 lines (the cap is 200). The seam was already visible in the
# behaviour: generating mirrors is a different job from validating frontmatter.
source "$SCRIPT_DIR/skills/mirror.sh"
source "$SCRIPT_DIR/skills/validate.sh"

case "${1:-sync}" in
  --check)
    rc=0
    validate_skills || rc=1
    validate_flows      || rc=1
    validate_flow_loops || rc=1
    validate_flow_dag   || rc=1
    validate_agents   || rc=1
    orphans check || rc=1
    for m in "${MIRRORS[@]}"; do check_mirror "$m" || rc=1; done
    check_commands || rc=1
    if [[ $rc -eq 0 ]]; then echo "OK: all mirrors and command files in sync"; fi
    exit $rc
    ;;
  sync|"")
    if ! validate_skills; then echo "✗ fix the invalid skill files above before syncing." >&2; exit 1; fi
    orphans prune
    for m in "${MIRRORS[@]}"; do sync_mirror "$m"; done
    sync_commands
    echo "Synced $(list_skills | wc -l) skills to ${#MIRRORS[@]} mirrors + command files."
    ;;
  *)
    echo "Usage: $0 [--check]" >&2
    exit 64
    ;;
esac
